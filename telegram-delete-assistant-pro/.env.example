# Secrets are configured in your host's Environment settings. Never commit real keys.
ZEUS_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=The_fxi_bot
ADMIN_IDS=
ADMIN_PANEL_USERNAME=fxi-admin
ADMIN_PANEL_PASSWORD=replace-with-a-long-unique-random-password
DATABASE_URL=
ADMIN_DATA_FILE=/tmp/fxi_admin_data.json
AI_SYSTEM_PROMPT=تو یک دستیار هوش مصنوعی فارسی‌زبان، دقیق، مفید و صمیمی هستی.
LOG_LEVEL=INFO

# Optional AI providers — configure at least one for AI replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
XAI_API_KEY=
XAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
COHERE_API_KEY=
COHERE_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=

# Optional speech-to-text. Groq is used first when configured.
FXI_STT_MODEL=whisper-large-v3-turbo
