# Secrets are configured in your host's Environment settings. Never commit real keys.
ZEUS_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=The_fxi_bot
ADMIN_IDS=
ADMIN_PANEL_USERNAME=fxi-admin
ADMIN_PANEL_PASSWORD=replace-with-a-long-unique-random-password
# Generate a long random secret and keep it stable across deployments.
SESSION_SECRET=replace-with-a-long-random-session-secret
# Public base URL only; do not append /admin (used for one-time admin invite links).
ADMIN_PANEL_URL=https://telegram-delete-assistant-pro.onrender.com
# Comma-separated extra trusted origins, only if the panel is intentionally accessed via another domain.
ADMIN_ALLOWED_ORIGINS=
# Render PostgreSQL: paste the database's Internal Database URL here. The app creates/migrates its tables automatically.
DATABASE_URL=
ADMIN_DATA_FILE=/tmp/fxi_admin_data.json
AI_SYSTEM_PROMPT=تو یک دستیار هوش مصنوعی فارسی‌زبان، دقیق، مفید و صمیمی هستی.
LOG_LEVEL=INFO

# OpenRouter is the only supported AI provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Voice transcription is disabled by default; no external AI provider other than OpenRouter is configured.
