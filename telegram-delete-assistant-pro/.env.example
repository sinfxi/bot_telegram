# Set these only in the hosting provider's environment settings; never commit real secrets.
BOT_TOKEN=
ADMIN_ID=
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable; changing it invalidates the encrypted saved session.
SESSION_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://telegram-delete-assistant-pro.onrender.com
DB_PATH=/data/bot.sqlite3
PORT=8000
LOG_LEVEL=INFO
