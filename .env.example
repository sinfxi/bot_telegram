# Required for Telegram bot polling
BOT_TOKEN=
# Telegram numeric ID allowed as primary admin identity (reserved for admin bot features)
ADMIN_ID=
# Set a long, unique secret; required to access /admin?key=...
ADMIN_PASSWORD=
# Railway PostgreSQL variable recommended: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local fallback:
DATABASE_URL=sqlite:///./foodmind.db
LOG_LEVEL=INFO
