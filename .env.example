BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789
DB_PATH=bot.db
PORT=8080

# AI Chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional independent models/keys; falls back to OPENAI_API_KEY / OPENAI_MODEL
QNA_OPENAI_API_KEY=
QNA_MODEL=gpt-5.5
ADMIN_AI_API_KEY=
ADMIN_AI_MODEL=

# Native Xray services (set the same manager token on bot + both Xray services)
XRAY_MANAGER_TOKEN=replace_with_a_long_random_secret
XRAY_VLESS_API_URL=http://xray-vless.railway.internal:8080
XRAY_VLESS_HOST=your-vless-tcp-proxy-host
XRAY_VLESS_PORT=your-vless-tcp-proxy-public-port
XRAY_VMESS_API_URL=http://xray-vmess.railway.internal:8080
XRAY_VMESS_HOST=your-vmess-tcp-proxy-host
XRAY_VMESS_PORT=your-vmess-tcp-proxy-public-port
