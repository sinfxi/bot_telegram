BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789
DB_PATH=bot.db
PORT=8080

# AI Chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional independent models/keys; falls back to OPENAI_API_KEY / OPENAI_MODEL
QNA_OPENAI_API_KEY=
QNA_MODEL=gpt-5.5
ADMIN_AI_API_KEY=
ADMIN_AI_MODEL=gpt-5.5

# Xray / 3x-ui-compatible panel (required for real config creation)
XRAY_PANEL_URL=https://your-panel.example.com
XRAY_PANEL_USERNAME=
XRAY_PANEL_PASSWORD=
XRAY_PUBLIC_HOST=your-server.example.com
XRAY_VERIFY_TLS=true
# Optional: default inbound ID for your own workflow
XRAY_INBOUND_ID=
