BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789
DB_PATH=bot.db
PORT=8080

# AI via Groq (recommended free tier; create key at https://console.groq.com/keys)
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# Optional independent Groq keys/models for each AI mode
QNA_GROQ_API_KEY=
QNA_MODEL=openai/gpt-oss-20b
ADMIN_GROQ_API_KEY=
ADMIN_AI_MODEL=openai/gpt-oss-20b

# Optional legacy OpenAI fallback (paid API usage may apply)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
QNA_OPENAI_API_KEY=
ADMIN_AI_API_KEY=

# Native Xray services (set the same manager token on bot + both Xray services)
XRAY_MANAGER_TOKEN=replace_with_a_long_random_secret
XRAY_VLESS_API_URL=http://xray-vless.railway.internal:8080
XRAY_VLESS_HOST=your-vless-tcp-proxy-host
XRAY_VLESS_PORT=your-vless-tcp-proxy-public-port
XRAY_VMESS_API_URL=http://xray-vmess.railway.internal:8080
XRAY_VMESS_HOST=your-vmess-tcp-proxy-host
XRAY_VMESS_PORT=your-vmess-tcp-proxy-public-port
